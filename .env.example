# Copy to .env.local for local development. In Vercel, set the same names under
# Project → Settings → Environment Variables. Never commit real values.

# --- Supabase (server only) ---
# Project URL: Supabase dashboard → Project Settings → Data API (https://<ref>.supabase.co)
SUPABASE_URL=
# Secret key (sb_secret_…): Supabase dashboard → Project Settings → API Keys → Secret keys.
# Bypasses RLS, so it must never reach the browser.
SUPABASE_SECRET_KEY=

# --- Cloudflare Turnstile ---
# Cloudflare dashboard → Turnstile → your widget (Managed mode) → Site key / Secret key.
# For local dev you can use Cloudflare's always-pass test keys instead:
#   site key:   1x00000000000000000000AA
#   secret key: 1x0000000000000000000000000000000AA
# Public: inlined into the browser bundle at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only.
TURNSTILE_SECRET_KEY=

# --- Vercel Cron ---
# Any long random string, e.g. `openssl rand -hex 32`. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>` when calling /api/keepalive.
CRON_SECRET=
